{
    "name": "dept-of-scrapyard-robotics/spectra6",
    "description": "Drive E Ink Spectra 6 (black, white, yellow, red, blue, green) ePaper panels over SPI with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "spectra6",
        "e6",
        "epaper",
        "e-ink",
        "display",
        "spi",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.10.0",
        "gpio/integrated-circuits": "^0.10.0",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "require-dev": {
        "gpio/digital": "^0.10.0",
        "gpio/spi": "^0.10.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0"
    },
    "suggest": {
        "gpio/digital": "^0.10.0 - DC, RST, BUSY and PWR pins for Spectra6SPITransport",
        "gpio/spi": "^0.10.0 - SPI connections for Spectra6SPITransport",
        "microscrap/scrapyard-linux": "^0.10.0 - native spidev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.10.0 - MPSSE SPI and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\Spectra6\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\Spectra6\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\Spectra6\\Providers\\Spectra6ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
